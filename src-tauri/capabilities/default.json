{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO" },
        { "path": "$AUDIO/**" },
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/storage/emulated/0" },
        { "path": "/storage/emulated/0/**" }
      ]
    }
  ]
}